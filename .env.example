# Host-side model cache dirs (mounted read-only into the container)
HF_CACHE_HOST=$HOME/.cache/huggingface
TORCH_CACHE_HOST=$HOME/.cache/torch
# Rootless podman socket (used by compose.override.yml)
PODMAN_SOCKET_HOST=/run/user/1000/podman/podman.sock
# Dashboard port on the host
CACHE_PULSE_PORT=8080
